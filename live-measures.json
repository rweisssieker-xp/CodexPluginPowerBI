                     "Name":  "_CapacityHoursBrutto",
                     "Description":  null,
                     "DataType":  8,
                     "Expression":  "\nVAR KeysPerGrain =\n    DISTINCT(\n        SELECTCOLUMNS(\n            \u0027Resource Demand\u0027,                           -- deine gemergte Tabelle\n            \"ResourceID\",        \u0027Resource Demand\u0027[ResourceID],\n            \"DepartmentID\",      \u0027Resource Demand\u0027[DepartmentID],\n            \"CapDate\",           \u0027Resource Demand\u0027[Capacity Date],\n            \"CapDays\",           \u0027Resource Demand\u0027[Capacity]      -- Kapazität in Tagen\n        )\n    )\nRETURN\nSUMX(KeysPerGrain, [CapDays] * 8.0)\n",
                     "FormatString":  null,
                     "IsHidden":  false,
