                     "Name":  "_Period Total Hours (Dept aware incl blank)",
                     "Description":  null,
                     "DataType":  8,
                     "Expression":  "\nVAR DeptIds =\n    VALUES( Departments[Department] )\nVAR IsDeptFiltered =\n    ISFILTERED( Departments[Department] ) || ISFILTERED( Departments[Department] )\nRETURN\nIF(\n    NOT IsDeptFiltered,\n    -- Keine Department-Auswahl: alles summieren inkl. BLANK DeptID\n    SUM( TimesheetLines[Period Total Hours] ),\n    -- Department ausgewählt: nur passende DeptIDs\n    CALCULATE(\n        SUM( TimesheetLines[Period Total Hours] ),\n        KEEPFILTERS(\n            TREATAS(\n                DeptIds,\n                TimesheetLines[gbl_submitterdepartment]\n            )\n        )\n    )\n)\n",
