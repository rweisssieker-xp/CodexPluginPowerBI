[
  {
    "Table": "IncidentsAllFields",
    "Name": "_SLA_Compliance",
    "OriginalExpression": "DIVIDE(CALCULATE(COUNTA(IncidentsAllFields[incidentid]),IncidentsAllFields[_SLA_Conflict]=0),COUNTA(IncidentsAllFields[incidentid]),0)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Escalation_Rate",
    "OriginalExpression": "DIVIDE(CALCULATE(COUNTA(IncidentsAllFields[incidentid]),IncidentsAllFields[escalationtime]<>BLANK()),COUNTA(IncidentsAllFields[incidentid]),0)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Ticket_Velocity",
    "OriginalExpression": "DIVIDE([_CountIncidents],CALCULATE(DISTINCTCOUNT(Calendar[Jahr]*52+ROUNDUP(WEEKNUM(Calendar[Date]),0)),ALL(Calendar)),0)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Resolution_Time_StdDev",
    "OriginalExpression": "STDEV.P(CALCULATE(IncidentsAllFields[pdw_totalresolutiontime_duration],ALL(IncidentsAllFields)))"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Peak_Month_Volume",
    "OriginalExpression": "CALCULATE(MAX(COUNTA(IncidentsAllFields[incidentid])),ALL(Calendar[Monat]))"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Low_Month_Volume",
    "OriginalExpression": "CALCULATE(MIN(COUNTA(IncidentsAllFields[incidentid])),ALL(Calendar[Monat]))"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_CSAT_Score",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[satisfactionindex], \">= 4\"), COUNTIF(IncidentsAllFields[satisfactionindex], \"<> -999\"), 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Top_Problem_Categories_Pareto",
    "OriginalExpression": "COUNTIF(IncidentsAllFields[type], \"Problem\") * 0.2"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Root_Cause_Identification_Rate",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[description], \"*Root Cause*\"), [_CountIncidents], 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_KB_Self_Service_Rate",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[typename], \"Knowledge Base\"), [_CountIncidents], 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Recurring_Issue_Ratio",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[resolvedbykbkbase], TRUE), [_CountIncidents], 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Agents_Needing_Training",
    "OriginalExpression": "COUNTIF(IncidentsAllFields[ownerid], \"<> BLANK\") - COUNTX(FILTER(SUMMARIZE(IncidentsAllFields, IncidentsAllFields[ownerid]), [_Agent_Skill_Gap] < 1.2 && [_Agent_Burnout_Risk] < 60), 1)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Agent_Performance_Rank",
    "OriginalExpression": "RANKX(SUMMARIZE(IncidentsAllFields, IncidentsAllFields[ownerid], \"AvgComplexity\", AVERAGE(IncidentsAllFields[prioritycode]), \"PerfScore\", [_FirstContactResolutionRate_FCR]), [PerfScore] / ([AvgComplexity] + 1))"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Queue_Wait_Time_Days",
    "OriginalExpression": "AVERAGE(IncidentsAllFields[_AVGCase Age Hours]) / 24"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Handoff_Success_Rate",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[isescalated], FALSE), [_CountIncidents], 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Ticket_Rework_Rate",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[iserrorticket], TRUE), [_CountIncidents], 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Peak_Business_Hours_Concentration",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[createdon], \">= 8:00\" & IncidentsAllFields[createdon], \"<= 18:00\"), [_CountIncidents], 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Agent_Fair_Performance_Rank",
    "OriginalExpression": "RANKX(SUMMARIZE(IncidentsAllFields, IncidentsAllFields[ownerid]), [_FirstContactResolutionRate_FCR] / (AVERAGE(IncidentsAllFields[prioritycode]) + 1) * [_AVG TTS] / 100)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Ticket_Type_TTR_Prediction",
    "OriginalExpression": "AVERAGE(IncidentsAllFields[_AVG TTS]) * (1 + (COUNTIF(IncidentsAllFields[type], \"Problem\") / [_CountIncidents]))"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_SLA_Breach_Factor_Analysis",
    "OriginalExpression": "DIVIDE([_SLA_Breach_Count], [_CountIncidents] * (1 + AVERAGE(IncidentsAllFields[prioritycode])), 0)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Root_Cause_Correlation_Score",
    "OriginalExpression": "INT((COUNTIF(IncidentsAllFields[prioritycode], \">2\") / [_CountIncidents] * 40 + COUNTIF(IncidentsAllFields[typename], \"*Problem*\") / [_CountIncidents] * 35 + [_Escalation_Rate] * 25))"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Seasonal_Root_Cause_Variance",
    "OriginalExpression": "STDEV.P(IncidentsAllFields[_CountIncidents]) / AVERAGE(IncidentsAllFields[_CountIncidents]) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Channel_Performance_Email",
    "OriginalExpression": "COUNTIF(IncidentsAllFields[caseorigincodename], \"*Email*\") / COUNTIF(IncidentsAllFields[caseorigincodename], \"<>\") * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Multi_Touch_Channel_Attribution",
    "OriginalExpression": "DIVIDE([_FirstContactResolutionRate_FCR], AVERAGE(IncidentsAllFields[caseorigincode]) + 1, 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Preferred_Channel_Detection",
    "OriginalExpression": "IF(COUNTIF(IncidentsAllFields[caseorigincodename], \"*Phone*\") > COUNTIF(IncidentsAllFields[caseorigincodename], \"*Email*\"), \"Phone\", \"Email\")"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Channel_CSAT_Differential",
    "OriginalExpression": "[_CSAT_Score] * DIVIDE(COUNTIF(IncidentsAllFields[customersatisfactioncodename], \"*Satisfied*\"), [_CountIncidents], 0)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Context_Switching_Cost",
    "OriginalExpression": "DIVIDE(COUNTIF(IncidentsAllFields[casetypecodename], \"<>\"), [_Avg_Cases_Per_Agent], 0) * 5"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Data_Privacy_Compliance",
    "OriginalExpression": "MIN((1 - [_Missing_Description_Rate] / 100 - DIVIDE(COUNTIF(IncidentsAllFields[contactidname], \"BLANK\"), [_CountIncidents], 0) * 50) * 100, 100)"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_Escalation_Authority_Compliance",
    "OriginalExpression": "DIVIDE([_Escalated_Tickets_Count], COUNTIF(IncidentsAllFields[isescalated], TRUE), 0) * 100"
  },
  {
    "Table": "IncidentsAllFields",
    "Name": "_SLA_Violation_Severity_Index",
    "OriginalExpression": "MIN(([_SLA_Breach_Count] / [_CountIncidents] * 100) * (1 + (([_AVG TTS] - AVERAGE(IncidentsAllFields[_AVG TTS])) / AVERAGE(IncidentsAllFields[_AVG TTS]))), 100)"
  }
]
