                     "Expression":  "COUNTROWS(\n    FILTER(\n        \u0027Projects\u0027,\n        NOT ISBLANK(\u0027Projects\u0027[Finish Date])\n            \u0026\u0026 \u0027Projects\u0027[Finish Date] \u003e= TODAY()\n            \u0026\u0026 \u0027Projects\u0027[Finish Date] \u003c= TODAY() + 30\n    )\n)"
