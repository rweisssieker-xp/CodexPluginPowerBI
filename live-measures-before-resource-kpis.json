                 {
                     "Name":  "Latest Status Summary",
                     "TableID":  127,
                     "Expression":  "\nVAR LatestRow =\n    TOPN(\n        1,\n        FILTER(\n            \u0027Status Reports\u0027,\n            NOT ISBLANK(\u0027Status Reports\u0027[Report Date])\n                \u0026\u0026 NOT ISBLANK(\u0027Status Reports\u0027[Status Summary])\n        ),\n        \u0027Status Reports\u0027[Report Date], DESC,\n        \u0027Status Reports\u0027[StatusReportID], DESC\n    )\nRETURN\n    MAXX(\n        LatestRow,\n        \u0027Status Reports\u0027[Status Summary]\n    )\n"
                 },
                 {
                     "Name":  "Latest Accomplished Activities",
                     "TableID":  127,
                     "Expression":  "\nVAR LatestRow =\n    TOPN(\n        1,\n        FILTER(\n            \u0027Status Reports\u0027,\n            NOT ISBLANK(\u0027Status Reports\u0027[Report Date])\n                \u0026\u0026 NOT ISBLANK(\u0027Status Reports\u0027[Accomplished Activities])\n        ),\n        \u0027Status Reports\u0027[Report Date], DESC,\n        \u0027Status Reports\u0027[StatusReportID], DESC\n    )\nRETURN\n    MAXX(\n        LatestRow,\n        \u0027Status Reports\u0027[Accomplished Activities]\n    )\n"
                 },
                 {
                     "Name":  "Latest Planned Activities",
                     "TableID":  127,
                     "Expression":  "\nVAR LatestRow =\n    TOPN(\n        1,\n        FILTER(\n            \u0027Status Reports\u0027,\n            NOT ISBLANK(\u0027Status Reports\u0027[Report Date])\n                \u0026\u0026 NOT ISBLANK(\u0027Status Reports\u0027[Planned Activities])\n        ),\n        \u0027Status Reports\u0027[Report Date], DESC,\n        \u0027Status Reports\u0027[StatusReportID], DESC\n    )\nRETURN\n    MAXX(\n        LatestRow,\n        \u0027Status Reports\u0027[Planned Activities]\n    )\n"
                 },
                 {
