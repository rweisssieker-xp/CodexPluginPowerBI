                 {
                     "Name":  "% Utilization",
                     "TableID":  286,
                     "Expression":  "DIVIDE(SUM(\u0027Resource Demand\u0027[Forecast Demand]), [_CapacityHoursNetto], 0)"
                 },
                 {
                     "Name":  "_CapacityHoursBrutto",
                     "TableID":  286,
                     "Expression":  "\nVAR KeysPerGrain =\n    DISTINCT(\n        SELECTCOLUMNS(\n            \u0027Resource Demand\u0027,                           -- deine gemergte Tabelle\n            \"ResourceID\",        \u0027Resource Demand\u0027[ResourceID],\n            \"DepartmentID\",      \u0027Resource Demand\u0027[DepartmentID],\n            \"CapDate\",           \u0027Resource Demand\u0027[Capacity Date],\n            \"CapDays\",           \u0027Resource Demand\u0027[Capacity]      -- Kapazität in Tagen\n        )\n    )\nRETURN\nSUMX(KeysPerGrain, [CapDays] * 8.0)\n"
                 },
                 {
                     "Name":  "_CapacityHoursNetto",
                     "TableID":  286,
                     "Expression":  "\n[_CapacityHoursBrutto] - SUM(\u0027Resource Demand\u0027[AtossAbsent])"
                 },
                 {
                     "Name":  "_TargetHoursNetto",
                     "TableID":  286,
                     "Expression":  "\n[_CapacityHoursNetto] * CapacityTargetValues[TargetValue]"
                 },
                 {
                     "Name":  "_TS-Hours",
                     "TableID":  149383342,
                     "Expression":  "SUM( \u0027TimesheetLineActuals\u0027[TS-Hours] )"
                 },
                 {
                     "Name":  "_Period Total Hours (Dept aware incl blank)",
                     "TableID":  149383345,
                     "Expression":  "\nVAR DeptIds =\n    VALUES( Departments[Department] )\nVAR IsDeptFiltered =\n    ISFILTERED( Departments[Department] ) || ISFILTERED( Departments[Department] )\nRETURN\nIF(\n    NOT IsDeptFiltered,\n    -- Keine Department-Auswahl: alles summieren inkl. BLANK DeptID\n    SUM( TimesheetLines[Period Total Hours] ),\n    -- Department ausgewählt: nur passende DeptIDs\n    CALCULATE(\n        SUM( TimesheetLines[Period Total Hours] ),\n        KEEPFILTERS(\n            TREATAS(\n                DeptIds,\n                TimesheetLines[gbl_submitterdepartment]\n            )\n        )\n    )\n)\n"
                 },
